[Unit]
Description=IS IT THERE YET temporary TURN credentials
After=network.target
[Service]
DynamicUser=yes
EnvironmentFile=/etc/rv-turn/issuer.env
ExecStart=/usr/bin/python3 /opt/rv-turn/issuer.py
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
