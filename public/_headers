/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' data: https://turn.62-84-183-92.sslip.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=3600

/.well-known/ii-app-metadata
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/.well-known/ii-alternative-origins
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/social/*
  Cache-Control: public, max-age=31536000, immutable
